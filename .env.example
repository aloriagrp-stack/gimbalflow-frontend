# ── GimbalFlow Frontend Environment ─────────────────────────────
# Google Sign-In (Firebase). Sign in at https://console.firebase.google.com:
#   1. Create a project (or reuse one).
#   2. Project settings → Your apps → Add web app → copy the config values.
#   3. Authentication → Sign-in method → enable Google.
#   4. Authorized domains: add your LAN IP (e.g. 10.60.80.117) if testing on phones.
# Then paste below and restart the dev server.

# Firebase Web App config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=

# Google OAuth Web Client ID (same web app → Project settings → Your apps → "Web client ID")
VITE_GOOGLE_CLIENT_ID=